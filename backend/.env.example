# Copy to .env and fill in real values (never commit .env)
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: use Vertex AI instead of Gemini API key quotas
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=whatsappbot-493906
GOOGLE_CLOUD_LOCATION=us-central1
# Set only in deployment secrets, never commit a real service-account JSON:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# direct = reliable ADK tool chain | llm = full SequentialAgent (slower)
CRISISIQ_ADK_MODE=direct
